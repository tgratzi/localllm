# Copy to .env next to compose.yaml. Contains NO secrets: the API key lives in a separate
# file that GEMMA_API_KEY_FILE points to. Never commit .env.

# Image to run. Local: a tag such as gemma-e2b-server:local.
# VM: always an Artifact Registry digest, e.g.
#   us-central1-docker.pkg.dev/my-project/gemma/gemma-e2b-server@sha256:...
GEMMA_IMAGE=gemma-e2b-server:local

# Address on the host that port 8080 is published on.
# Local: 127.0.0.1. VM: the VM's internal IP (scripts/deploy-vm.sh sets this).
GEMMA_BIND_ADDRESS=127.0.0.1
# Host port. The container always listens on 8080 inside.
GEMMA_HOST_PORT=8080

# Path on the host to a file holding the API key (one key per line; '#' lines ignored).
GEMMA_API_KEY_FILE=./secrets/api_key

# Tokens of context shared by all parallel slots. 8192 fits easily in 16 GB with Q8_0.
GEMMA_CTX_SIZE=8192
# CPU threads for generation. Start with the number of vCPUs and measure.
GEMMA_THREADS=4
# Requests processed at once. Each slot gets GEMMA_CTX_SIZE / GEMMA_PARALLEL tokens.
GEMMA_PARALLEL=1
# Server-side cap on generated tokens per request.
GEMMA_MAX_TOKENS=1024
# HTTP read/write timeout in seconds.
GEMMA_TIMEOUT_SECONDS=300
# Gemma "thinking" output: off | on | auto.
GEMMA_REASONING=off
# Container memory limit. Keep below the VM's RAM so the OS keeps headroom.
GEMMA_MEM_LIMIT=12g
