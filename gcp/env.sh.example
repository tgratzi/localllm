# Copy to gcp/env.sh and edit. Every GCP script sources it. No secrets go here.
# gcp/env.sh is gitignored.

# --- Project and location (required) -------------------------------------------------
PROJECT_ID=""                 # e.g. my-project-123
REGION="us-central1"          # Cloud Run, subnets and Artifact Registry
ZONE="us-central1-a"          # the VM

# --- Network ----------------------------------------------------------------------------
NETWORK="gemma-vpc"                     # created as a custom-mode VPC if missing
VM_SUBNET="gemma-vm-subnet"
VM_SUBNET_RANGE="10.80.0.0/24"
RUN_SUBNET="gemma-run-egress-subnet"    # Cloud Run Direct VPC egress uses IPs from here
RUN_SUBNET_RANGE="10.80.16.0/26"        # /26 or larger is recommended for Direct VPC egress
ENABLE_IAP_SSH="true"                   # firewall rule for SSH from the IAP range only
CREATE_NAT="true"                       # Cloud NAT for the VM subnet (apt installs on a VM with no public IP)

# --- Artifact Registry ------------------------------------------------------------------
AR_REPO="gemma"
IMAGE_NAME="gemma-e2b-server"
ENABLE_AR_SCANNING="true"               # Artifact Analysis vulnerability scanning on push (billed per image)

# --- VM ------------------------------------------------------------------------------------
VM_NAME="gemma-e2b-vm"
VM_MACHINE_TYPE="e2-standard-4"         # 4 vCPU / 16 GB. Resize after measuring.
VM_DISK_SIZE_GB="50"                    # holds the ~5 GB image plus one previous version
VM_DISK_TYPE="pd-balanced"
VM_SA_NAME="gemma-vm"                   # service account attached to the VM
VM_TAG="gemma-llm"                      # network tag the firewall rules target
INSTALL_OPS_AGENT="false"               # "true" adds logging/monitoring writer roles to the VM SA

# --- Container settings on the VM (non-secret) ----------------------------------------
GEMMA_CTX_SIZE="8192"
GEMMA_THREADS="4"
GEMMA_PARALLEL="1"
GEMMA_MAX_TOKENS="1024"
GEMMA_TIMEOUT_SECONDS="300"
GEMMA_REASONING="off"
GEMMA_MEM_LIMIT="12g"

# --- Secret --------------------------------------------------------------------------------
SECRET_NAME="gemma-api-key"

# --- Cloud Run application ------------------------------------------------------------
RUN_SERVICE="gemma-app"
RUN_IMAGE=""                            # YOUR application image (required by configure-cloud-run.sh)
RUN_SA_NAME="gemma-app-run"             # runtime service account of the Cloud Run service
RUN_INVOKERS=""                         # comma-separated, e.g. "serviceAccount:caller@p.iam.gserviceaccount.com,group:team@example.com"
RUN_CONCURRENCY="4"                     # requests per Cloud Run instance; the model is the bottleneck
RUN_MAX_INSTANCES="3"
RUN_TIMEOUT="300s"
